{
  "entities": {
    "Responder": {
      "title": "Responder",
      "description": "Authenticated admin, doctor, paramedic, or emergency room clinician profile.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "email": {
          "type": "string",
          "minLength": 3,
          "maxLength": 160
        },
        "role": {
          "type": "string",
          "enum": ["ADMIN", "DOCTOR", "PARAMEDIC", "ER_PHYSICIAN", "TRIAGE_NURSE"]
        },
        "seeded": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "displayName", "email", "role", "seeded", "createdAt", "updatedAt"]
    },
    "Patient": {
      "title": "Patient",
      "description": "Enrolled patient biometric signature and critical emergency medical record owned by the Admin.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "mrn": {
          "type": "string",
          "minLength": 8,
          "maxLength": 16,
          "pattern": "^MRN-[0-9]{4,10}$"
        },
        "fingerprintCode": {
          "type": "string",
          "minLength": 7,
          "maxLength": 36,
          "pattern": "^FP-[A-Z0-9\\-]{4,32}$"
        },
        "fullName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "age": {
          "type": "number"
        },
        "sex": {
          "type": "string",
          "enum": ["Male", "Female", "Other"]
        },
        "bloodType": {
          "type": "string",
          "enum": ["O+", "O-", "A+", "A-", "B+", "B-", "AB+", "AB-"]
        },
        "avatarUrl": {
          "type": "string",
          "minLength": 0,
          "maxLength": 300
        },
        "allergies": {
          "type": "array"
        },
        "medications": {
          "type": "array"
        },
        "conditions": {
          "type": "array"
        },
        "criticalAlerts": {
          "type": "array"
        },
        "emergencyContactName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "emergencyContactRelation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "emergencyContactPhone": {
          "type": "string",
          "minLength": 4,
          "maxLength": 40
        },
        "dnrStatus": {
          "type": "boolean"
        },
        "organDonor": {
          "type": "boolean"
        },
        "lastScannedAt": {
          "type": "string",
          "format": "date-time"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "mrn",
        "fingerprintCode",
        "fullName",
        "age",
        "sex",
        "bloodType",
        "avatarUrl",
        "allergies",
        "medications",
        "conditions",
        "criticalAlerts",
        "emergencyContactName",
        "emergencyContactRelation",
        "emergencyContactPhone",
        "dnrStatus",
        "organDonor",
        "lastScannedAt",
        "createdAt",
        "updatedAt"
      ]
    },
    "TriageAssessment": {
      "title": "TriageAssessment",
      "description": "AI-synthesized emergency triage evaluation based on unconscious patient history and live vitals.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "patientId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "heartRate": {
          "type": "number"
        },
        "spo2": {
          "type": "number"
        },
        "bpSystolic": {
          "type": "number"
        },
        "bpDiastolic": {
          "type": "number"
        },
        "gcsScore": {
          "type": "number"
        },
        "chiefComplaint": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "esiLevel": {
          "type": "number"
        },
        "clinicalSynopsis": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1500
        },
        "immediateActions": {
          "type": "array"
        },
        "contraindications": {
          "type": "array"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "patientId",
        "heartRate",
        "spo2",
        "bpSystolic",
        "bpDiastolic",
        "gcsScore",
        "chiefComplaint",
        "esiLevel",
        "clinicalSynopsis",
        "immediateActions",
        "contraindications",
        "createdAt"
      ]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Immutable clinical audit event for biometric scans, notifications, and doctor links.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "patientId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "actionType": {
          "type": "string",
          "enum": [
            "SCAN_MATCH",
            "DOCTOR_BIOMETRIC_MATCH",
            "EMERGENCY_CONTACT_NOTIFIED",
            "RECORD_ENROLLED",
            "RECORD_UPDATED",
            "DOCTOR_LINK_CREATED",
            "DOCTOR_LINK_REVOKED"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "actorEmail": {
          "type": "string",
          "minLength": 3,
          "maxLength": 160
        },
        "actorName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "actorRole": {
          "type": "string",
          "enum": ["ADMIN", "DOCTOR", "PARAMEDIC", "ER_PHYSICIAN", "TRIAGE_NURSE"]
        },
        "fingerprintCode": {
          "type": "string",
          "minLength": 0,
          "maxLength": 36
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "patientId",
        "actionType",
        "summary",
        "actorEmail",
        "actorName",
        "actorRole",
        "fingerprintCode",
        "createdAt"
      ]
    },
    "MedicalHistoryEntry": {
      "title": "MedicalHistoryEntry",
      "description": "Historical clinical record (past surgery, hospitalization, lab baseline, immunization, trauma) for a patient.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "patientId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "category": {
          "type": "string",
          "enum": ["SURGERY", "HOSPITALIZATION", "LAB_REPORT", "IMMUNIZATION", "TRAUMA_ER", "DIAGNOSIS"]
        },
        "eventDate": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "title": {
          "type": "string",
          "minLength": 2,
          "maxLength": 160
        },
        "facility": {
          "type": "string",
          "minLength": 2,
          "maxLength": 160
        },
        "clinician": {
          "type": "string",
          "minLength": 0,
          "maxLength": 120
        },
        "notes": {
          "type": "string",
          "minLength": 1,
          "maxLength": 800
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "patientId",
        "category",
        "eventDate",
        "title",
        "facility",
        "clinician",
        "notes",
        "createdAt"
      ]
    },
    "DoctorBiometricLink": {
      "title": "DoctorBiometricLink",
      "description": "Admin-approved link binding a patient's biometric signature to a doctor's Gmail ID for gated access.",
      "type": "object",
      "properties": {
        "adminUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "adminEmail": {
          "type": "string",
          "minLength": 3,
          "maxLength": 160
        },
        "doctorEmail": {
          "type": "string",
          "minLength": 3,
          "maxLength": 160
        },
        "doctorName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "patientId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "patientMrn": {
          "type": "string",
          "minLength": 8,
          "maxLength": 16,
          "pattern": "^MRN-[0-9]{4,10}$"
        },
        "fingerprintCode": {
          "type": "string",
          "minLength": 7,
          "maxLength": 36,
          "pattern": "^FP-[A-Z0-9\\-]{4,32}$"
        },
        "status": {
          "type": "string",
          "enum": ["ACTIVE", "REVOKED"]
        },
        "biometricVerified": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "adminUid",
        "adminEmail",
        "doctorEmail",
        "doctorName",
        "patientId",
        "patientMrn",
        "fingerprintCode",
        "status",
        "biometricVerified",
        "createdAt",
        "updatedAt"
      ]
    },
    "ClinicalVaultDossier": {
      "title": "ClinicalVaultDossier",
      "description": "Scoped clinical dossier and history snapshot unlocked only after a linked doctor completes biometric verification.",
      "type": "object",
      "properties": {
        "adminUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "patientId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "doctorEmail": {
          "type": "string",
          "minLength": 3,
          "maxLength": 160
        },
        "fullName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "age": {
          "type": "number"
        },
        "sex": {
          "type": "string",
          "enum": ["Male", "Female", "Other"]
        },
        "bloodType": {
          "type": "string",
          "enum": ["O+", "O-", "A+", "A-", "B+", "B-", "AB+", "AB-"]
        },
        "mrn": {
          "type": "string",
          "minLength": 8,
          "maxLength": 16,
          "pattern": "^MRN-[0-9]{4,10}$"
        },
        "fingerprintCode": {
          "type": "string",
          "minLength": 7,
          "maxLength": 36,
          "pattern": "^FP-[A-Z0-9\\-]{4,32}$"
        },
        "allergies": {
          "type": "array"
        },
        "medications": {
          "type": "array"
        },
        "conditions": {
          "type": "array"
        },
        "criticalAlerts": {
          "type": "array"
        },
        "historySummaries": {
          "type": "array"
        },
        "emergencyContactName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "emergencyContactRelation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "emergencyContactPhone": {
          "type": "string",
          "minLength": 4,
          "maxLength": 40
        },
        "dnrStatus": {
          "type": "boolean"
        },
        "organDonor": {
          "type": "boolean"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "adminUid",
        "patientId",
        "doctorEmail",
        "fullName",
        "age",
        "sex",
        "bloodType",
        "mrn",
        "fingerprintCode",
        "allergies",
        "medications",
        "conditions",
        "criticalAlerts",
        "historySummaries",
        "emergencyContactName",
        "emergencyContactRelation",
        "emergencyContactPhone",
        "dnrStatus",
        "organDonor",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/responders/{userId}": {
      "schema": { "$ref": "#/entities/Responder" },
      "description": "Authenticated admin or doctor profiles keyed by Firebase Auth UID."
    },
    "/patients/{patientId}": {
      "schema": { "$ref": "#/entities/Patient" },
      "description": "Master biometric-indexed patient records owned and listed exclusively by Admin."
    },
    "/triageAssessments/{assessmentId}": {
      "schema": { "$ref": "#/entities/TriageAssessment" },
      "description": "Immutable AI emergency triage assessments linked to a patient."
    },
    "/auditLogs/{logId}": {
      "schema": { "$ref": "#/entities/AuditLog" },
      "description": "Immutable clinical scan, doctor-link, and notification audit trail."
    },
    "/medicalHistories/{historyId}": {
      "schema": { "$ref": "#/entities/MedicalHistoryEntry" },
      "description": "Patient historical surgeries, hospitalizations, lab baselines, and prior ER visits."
    },
    "/doctorBiometricLinks/{linkId}": {
      "schema": { "$ref": "#/entities/DoctorBiometricLink" },
      "description": "Admin-managed links connecting a patient biometric signature to an authorized doctor Gmail."
    },
    "/doctorBiometricLinks/{linkId}/vault/{vaultDocId}": {
      "schema": { "$ref": "#/entities/ClinicalVaultDossier" },
      "description": "Gated patient clinical dossier unlocked via single-doc get once biometricVerified is true."
    }
  }
}
